#!/bin/sh
# postinst luci-app-bitstailscale
# Reload LuCI ACL/menu dan auto-update tailscale ke versi resmi terbaru (best-effort).

[ -z "$IPKG_INSTROOT" ] && {
	/etc/init.d/rpcd restart >/dev/null 2>&1
	# Hapus hanya cache index/module LuCI. JANGAN sentuh /tmp/.uci:
	# itu delta UCI seluruh sistem -> menghapusnya membuang perubahan
	# `uci set` yang belum di-commit milik paket lain.
	rm -rf /tmp/luci-indexcache /tmp/luci-modulecache

	# Tailscale "official latest": paket ini Depends ke `tailscale` (binary dari feed
	# atau yang sudah terpasang). Usahakan naik ke rilisan resmi terbaru secara
	# latar-belakang; non-fatal dan tidak menghalangi proses instalasi.
	if [ -x /usr/sbin/tailscale ]; then
		( tailscale update >/dev/null 2>&1 & )
	fi
}

exit 0
