#!/bin/sh

# Copyright (C) 2025 asvow
# SPDX-License-Identifier: GPL-3.0-only

# Error handling function
revert_exit() {
	logger -p daemon.err -t tailscale_helper "$(date '+%Y/%m/%d %H:%M:%S') $1"
	uci revert dhcp && uci revert network && uci revert firewall
	/etc/init.d/tailscale stop
	exit 1
}

# Use flock to acquire an exclusive lock.
# Kegagalan lock berarti ada instance lain yang sedang berjalan: keluar
# diam-diam. JANGAN revert konfigurasi / stop service -- itu justru merusak
# konfigurasi milik instance lain yang sedang sehat.
LOCK_FILE="/var/lock/tailscale.lock"
exec 9> "$LOCK_FILE"
if ! flock -xn 9; then
	logger -p daemon.info -t tailscale_helper "another instance holds $LOCK_FILE, exiting"
	exit 0
fi
# Tidak ada trap penghapus: cukup keluar, fd 9 ditutup otomatis dan lock
# dilepas. Meng-unlink file lock saat fd masih terbuka membuat proses
# berikutnya mengunci inode baru sehingga lock lama tidak berlaku lagi, dan
# trap EXIT juga menimpa exit status sebenarnya.

# Execute tailscale up command (setelah lock, supaya instance kedua tidak
# sempat menjalankan `up` ganda)
/usr/sbin/tailscale up --reset "$@" || revert_exit "tailscale up failed."

# Wait for Tailscale IPv4 address
count=0
while [ -z "$(ifconfig | grep 'tailscale' | awk '{print $1}')" ] || [ -z "$(tailscale ip -4)" ]; do
	sleep 2
	count=$((count + 1))
	[ "${count}" -ge 5 ] && revert_exit "Failed to get Tailscale IPv4 address after 5 attempts."
done

# Configure Tailscale MagicDNS
if [ "$ACCEPT_DNS" = "1" ]; then
	MagicDNSSuffix=$(tailscale status --json 2>/dev/null | awk -F'"' '/"MagicDNSSuffix"/ {last=$(NF-1)} END {print last}')
	# Guard: suffix kosong (status gagal / belum siap) akan membentuk target
	# `//100.100.100.100` yang tidak valid, dan suffix mengandung `/` atau
	# spasi akan merusak format entry dnsmasq. Lewati, jangan ubah UCI.
	case "$MagicDNSSuffix" in
		'' | */* | *' '*)
			logger -p daemon.warn -t tailscale_helper "MagicDNSSuffix unavailable, skipping dnsmasq config"
			MagicDNSSuffix=""
			;;
	esac
	if [ -n "$MagicDNSSuffix" ]; then
		target_address="/$MagicDNSSuffix/100.100.100.100"
		index=$(uci show dhcp | grep 'dhcp.@dnsmasq\[[0-9]\+\]=dnsmasq' | grep -o '[0-9]\+')
		for i in $index; do
			if ! uci -q get "dhcp.@dnsmasq[$i].address" 2>/dev/null | grep -qxF "$target_address"; then
				uci add_list "dhcp.@dnsmasq[$i].address=$target_address" || revert_exit "Failed to add DNS address."
			fi
		done
	fi
fi

# Catatan: interface netifd untuk Tailscale sengaja TIDAK dibuat lagi.
# Mengikat interface TUN Tailscale ke netifd terbukti merusak TUN, jadi blok
# konfigurasi network.ts_lan/network.tailscale dihapus dari kode ini.

# Configure exit node firewall rules
if [ -n "$EXIT_NODE" ]; then
	uci set firewall.@defaults[0].forward='REJECT' || revert_exit "Failed to set default forward policy to REJECT."
	# Find LAN->WAN forwarding rule indices. Hasil grep bisa memuat angka dari
	# baris konteks, jadi saring hanya indeks yang benar-benar numerik, dan
	# nonaktifkan SEMUA aturan lan->wan yang cocok (bisa lebih dari satu).
	index=$(uci show firewall | grep "firewall.@forwarding\[[0-9]\+\]\.src='lan'" -B 1 -A 1 | grep "firewall.@forwarding\[[0-9]\+\]\.dest='wan'" | grep -o '[0-9]\+')
	valid_index=""
	for idx in $index; do
		case "$idx" in
			'' | *[!0-9]*) ;;
			*) valid_index="$valid_index $idx" ;;
		esac
	done
	if [ -z "${valid_index# }" ]; then
		revert_exit "Failed to disable forwarding rule (no LAN->WAN rule found)."
	fi
	for idx in $valid_index; do
		uci set "firewall.@forwarding[$idx].enabled=0" || revert_exit "Failed to disable forwarding rule."
	done
fi

# Configure subnet routes for site to site
if [ -n "$SUBNET_ROUTES" ]; then
	i=1
	ts_ip=$(tailscale ip -4)
	for route in $SUBNET_ROUTES; do
		[ -n "$(uci batch <<-EOF 2>&1
			set network.ts_subnet$i='route'
			set network.ts_subnet$i.interface='tailscale'
			set network.ts_subnet$i.target=$route
			set network.ts_subnet$i.gateway=$ts_ip
		EOF
		)" ] && revert_exit "Failed to configure subnet routes for site to site."
		i=$((i + 1))
	done
fi

# Configure firewall zone and rules
if [ -n "$ACCESS" ]; then
	[ -n "$(uci batch <<-EOF 2>&1
		set firewall.tszone='zone'
		set firewall.tszone.input='ACCEPT'
		set firewall.tszone.output='ACCEPT'
		set firewall.tszone.forward='ACCEPT'
		set firewall.tszone.masq='1'
		set firewall.tszone.mtu_fix='1'
		set firewall.tszone.name='tailscale'
		set firewall.tszone.device='tailscale0'
	EOF
	)" ] && revert_exit "Failed to create firewall zone and forwarding rules for Tailscale."
fi

# Configure specific firewall forwarding rules between Tailscale, LAN, and WAN.
# Format: <nama section>:<src>:<dest>. Hanya opsi yang dipilih di UCI (ACCESS)
# yang dibuat, dengan pencocokan per-kata (bukan substring).
for rule in ts_ac_lan:tailscale:lan ts_ac_wan:tailscale:wan lan_ac_ts:lan:tailscale wan_ac_ts:wan:tailscale; do
	rule_name=${rule%%:*}
	rule_rest=${rule#*:}
	rule_src=${rule_rest%%:*}
	rule_dest=${rule_rest#*:}
	case " $ACCESS " in
		*" $rule_name "*) ;;
		*) continue ;;
	esac
	[ -n "$(uci batch <<-EOF 2>&1
		set firewall.$rule_name=forwarding
		set firewall.$rule_name.src='$rule_src'
		set firewall.$rule_name.dest='$rule_dest'
	EOF
	)" ] && revert_exit "Failed to create firewall forwarding rule $rule_name."
done

# Migrasi dari versi lama: buang sisa konfigurasi netifd (interface TUN rusak
# bila diikat ke netifd) dan pastikan zone firewall memakai device tailscale0.
# Section ts_lan/network.tailscale tidak lagi dibuat oleh kode sekarang, jadi
# pada instalasi baru perintah delete di bawah adalah no-op.
uci -q delete network.tailscale
uci -q delete network.ts_lan
uci -q delete firewall.tszone.network
uci -q set firewall.tszone.device='tailscale0'

# Commit configuration changes and reload service
[ -n "$(uci changes dhcp)" ] && uci commit dhcp && /etc/init.d/dnsmasq reload
[ -n "$(uci changes network)" ] && uci commit network && /etc/init.d/network reload
[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload
exit 0
