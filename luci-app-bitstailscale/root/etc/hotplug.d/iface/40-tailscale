#!/bin/sh

# Filter event lebih dulu sebelum memanggil `uci`, supaya event interface
# yang tidak relevan tidak memicu proses/proyeksi kerja tambahan.
[ "$ACTION" = ifup ] || [ "$ACTION" = ifupdate ] || exit 0
[ "$ACTION" = ifupdate ] && [ -z "$IFUPDATE_ADDRESSES" ] && [ -z "$IFUPDATE_DATA" ] && exit 0

[ "$(uci -q get tailscale.settings.enabled)" = "1" ] || exit 0
/etc/init.d/tailscale start > /tmp/tailscale.log 2>&1 &
